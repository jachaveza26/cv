{
  "type": "object",
  "required": ["identity", "profile", "experience", "projects", "skills", "education", "certifications", "languages"],
  "additionalProperties": false,
  "properties": {
    "identity": {
      "type": "object",
      "required": ["name", "title", "tagline", "location", "email", "linkedin", "github", "portfolio", "site", "photo"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$" },
        "linkedin": { "type": "string", "pattern": "^https://www\\.linkedin\\.com/in/" },
        "github": { "type": "string", "pattern": "^https://github\\.com/" },
        "portfolio": { "type": "string", "pattern": "^https://github\\.com/jachaveza26/portfolio$" },
        "site": { "type": "string", "pattern": "^https://[a-z0-9.-]+$" },
        "photo": { "type": "string", "pattern": "\\.(webp|jpg|png)$" }
      }
    },
    "profile": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "org", "location", "start", "end", "summary", "bullets", "links", "compact"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "org": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "end": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}$" },
          "summary": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "url"],
              "additionalProperties": false,
              "properties": { "label": { "type": "string", "minLength": 1 }, "url": { "type": "string", "pattern": "^https://" } }
            }
          },
          "compact": { "type": "boolean" }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "oneLiner", "stack", "status", "featured", "url"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "oneLiner": { "type": "string", "minLength": 1 },
          "stack": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "status": { "type": "string", "minLength": 1 },
          "featured": { "type": "boolean" },
          "url": { "type": "string", "pattern": "^https://github\\.com/jachaveza26/portfolio/blob/main/projects/[a-z0-9-]+\\.md$" }
        }
      }
    },
    "skills": {
      "type": "object",
      "required": ["hard", "pdf", "soft"],
      "additionalProperties": false,
      "properties": {
        "hard": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["group", "items"],
            "additionalProperties": false,
            "properties": {
              "group": { "type": "string", "minLength": 1 },
              "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "pdf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["group", "items"],
            "additionalProperties": false,
            "properties": {
              "group": { "type": "string", "minLength": 1 },
              "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "soft": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "evidence"],
            "additionalProperties": false,
            "properties": { "name": { "type": "string", "minLength": 1 }, "evidence": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["credential", "institution", "country", "year"],
        "additionalProperties": false,
        "properties": {
          "credential": { "type": "string", "minLength": 1 },
          "institution": { "type": "string", "minLength": 1 },
          "country": { "type": "string", "minLength": 1 },
          "year": { "type": "string", "pattern": "^\\d{4}$" }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["credential", "institution", "country", "completed"],
        "additionalProperties": false,
        "properties": {
          "credential": { "type": "string", "minLength": 1 },
          "institution": { "type": "string", "minLength": 1 },
          "country": { "type": "string", "minLength": 1 },
          "completed": { "type": "string", "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$" }
        }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["language", "level"],
        "additionalProperties": false,
        "properties": { "language": { "type": "string", "minLength": 1 }, "level": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
